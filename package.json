    "url": "git+https://github.com/joygram/DeukAgentFlow.git"
  },
  "bugs": {
    "url": "https://github.com/joygram/DeukAgentFlow/issues"
  },
  "homepage": "https://github.com/joygram/DeukAgentFlow#readme",
  "files": [
    "LICENSE",
