    "docs/badges/**/*",
    "docs/how-it-works.md",
    "docs/how-it-works.ko.md",
    "docs/principles.md",
    "docs/principles.ko.md",
    "docs/usage-guide.md",
    "docs/usage-guide.ko.md",
