    "templates/**/*",
    "scripts/bundle-vscode-vsix.ts",
    "scripts/cli-args.ts",
    "scripts/cli-coding-step.ts",
    "scripts/cli-context-commands.ts",
    "scripts/cli-doc-commands.ts",
    "scripts/cli-init-claude.ts",
