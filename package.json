    "scripts/cli-init-logic.ts",
    "scripts/cli-init-migrate.ts",
    "scripts/cli-init-workspace.ts",
    "scripts/cli-integrity-commands.ts",
    "scripts/cli-locales.ts",
    "scripts/cli-persona-commands.ts",
    "scripts/cli-prompts.ts",
    "scripts/cli-rule-compiler.ts",
    "scripts/cli-rule-registry.ts",
    "scripts/cli-skill-commands.ts",
    "scripts/cli-telemetry-commands.ts",
    "scripts/cli-ticket-command-shared.ts",
    "scripts/cli-ticket-commands.ts",
    "scripts/cli-ticket-docmeta.ts",
    "scripts/cli-ticket-document.ts",
    "scripts/cli-ticket-evidence-quality.ts",
    "scripts/cli-ticket-evidence-slots.ts",
    "scripts/cli-ticket-evidence.ts",
    "scripts/cli-ticket-home.ts",
    "scripts/cli-ticket-index.ts",
    "scripts/cli-ticket-migration.ts",
    "scripts/cli-ticket-parser.ts",
    "scripts/cli-ticket-scan.ts",
    "scripts/cli-ticket-surface.ts",
    "scripts/cli-usage-commands.ts",
    "scripts/cli-utils.ts",
    "scripts/cli.ts",
    "scripts/integrity-narrative-db.ts",
    "scripts/integrity-narrative-source.ts",
    "scripts/lint-md.ts",
    "scripts/lint-rules.ts",
    "scripts/markdown-headings.ts",
    "scripts/markdown-prose-spans.ts",
    "scripts/merge-logic.ts",
    "scripts/persona-journal-db.ts",
    "scripts/persona-verbosity-attempts.ts",
    "scripts/persona-vocab-db.ts",
    "scripts/persona-vocab-migrate.ts",
    "scripts/plan-parser.ts",
    "scripts/publish-dual-npm.ts",
    "scripts/smoke-npm-docker.ts",
    "scripts/smoke-npm-local.ts",
    "scripts/ticket-evidence-validators.ts",
    "scripts/ticket-machine.ts",
    "scripts/ticket-workflow.ts",
    "scripts/oss-prepack.js",
    "scripts/out/**/*",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "CHANGELOG.ko.md"
  ],
  "scripts": {
    "bump:dev": "commit-and-tag-version -r patch --skip.changelog --skip.commit --skip.tag",
    "prepare": "git config core.hooksPath .githooks",
    "dev:install": "npx tsc -p tsconfig.scripts.json && node scripts/out/scripts/dev-install.js",
    "build:vscode": "npx tsc -p tsconfig.scripts.json && node scripts/out/scripts/bundle-vscode-vsix.js",
    "prepack": "node scripts/oss-prepack.js",
    "install:vscode": "node scripts/out/scripts/install-vscode-vsix.js --all",
    "install:vscode:desktop": "node scripts/out/scripts/install-vscode-vsix.js --desktop",
    "install:vscode:server": "node scripts/out/scripts/install-vscode-vsix.js --server",
    "lint:md": "node scripts/out/scripts/lint-md.js",
    "check:overblock": "node scripts/checks/overblock-check.js",
    "publish": "npm publish --access public --ignore-scripts",
    "publish:dry": "npm publish --access public --ignore-scripts --dry-run",
    "smoke:npm:local": "node scripts/out/scripts/smoke-npm-local.js",
    "smoke:npm:docker": "node scripts/out/scripts/smoke-npm-docker.js",
    "check:surface": "node scripts/checks/surface-check.js",
    "check:exports": "node scripts/checks/dead-exports.mjs",
    "check": "npm run check:overblock && npm run check:surface && npm run check:emoji && npm run check:narrative && npm run check:ending && npm run check:ending-scope && npm run check:hook-gate && npm run check:hooks && npm run check:gate-severity &&npm run check:verbosity-attempt && npm run check:entry-routing",
    "check:gate-severity": "node scripts/checks/gate-severity-check.mjs",
    "check:verbosity-attempt": "node scripts/checks/verbosity-attempt-check.mjs",
    "check:entry-routing": "node scripts/checks/entry-routing-check.mjs",
    "check:emoji": "node scripts/checks/emoji-pool-check.js",
    "check:narrative": "node scripts/checks/narrative-regression.mjs",
    "check:ending": "node scripts/checks/ending-regression.mjs",
    "check:ending-scope": "node scripts/checks/ending-scope-check.mjs",
    "check:hook-gate": "node scripts/checks/hook-gate-check.mjs",
    "bench:injection": "node scripts/checks/injection-bench.js",
    "check:imports": "node scripts/checks/organize-imports.mjs",
    "check:rules": "node scripts/checks/rule-citation-check.mjs",
    "check:dead": "node scripts/checks/strip-dead-loop.mjs",
    "diag:vocab-coverage": "node scripts/tools/vocab-coverage.js",
    "diag:vocab-form": "node scripts/tools/vocab-form-check.js",
    "check:hooks": "node templates/hooks/lib/hooktest.mjs && node templates/hooks/lib/selftest.mjs && node templates/hooks/lib/personatest.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "deuk-agent-flow": "bin/deuk-agent-flow.js",
    "deukagentflow": "bin/deuk-agent-flow.js",
    "deuk-agent-rule": "bin/deuk-agent-rule.js",
    "deukagentrule": "bin/deuk-agent-rule.js"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^25.9.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "ejs": "^5.0.2",
    "marked": "^18.0.9",
    "xstate": "^5.32.1",
    "yaml": "^2.8.3"
  },
  "type": "module"
}
