{
  "name": "deuk-agent-flow",
  "displayName": "Deuk Agent Flow",
  "description": "VS Code extension for the Deuk Agent Flow command center and ticket workspace controls.",
  "version": "5.0.7",
  "publisher": "deukpack",
  "engines": {
    "vscode": "^1.85.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joygram/DeukAgentFlow"
  },
  "icon": "media/agentflow-128.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:deukagentflow-command-center",
    "onCommand:deukagentflow.agentflow.openCommandCenter",
    "onCommand:deukagentflow.agentflow.refresh",
    "onCommand:deukagentflow.agentflow.setActiveTicket",
    "onCommand:deukagentflow.agentflow.openTicket",
    "onCommand:deukagentflow.agentflow.runGuard",
    "onCommand:deukagentflow.agentflow.copyHandoff",
    "onCommand:deukagentflow.agentflow.switchTarget"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "deukagentflow-secondary",
          "title": "AgentFlow",
          "icon": "media/agentflow.svg"
        }
      ]
    },
    "views": {
      "deukagentflow-secondary": [
        {
          "id": "deukagentflow-command-center",
          "name": "AgentFlow Command Center",
          "type": "webview",
          "icon": "media/agentflow.svg",
          "contextualTitle": "AgentFlow Command Center",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "deukagentflow.agentflow.openCommandCenter",
        "title": "AgentFlow: Open Command Center"
      },
      {
        "command": "deukagentflow.agentflow.openSidebar",
        "title": "AgentFlow: Reveal Secondary Sidebar Command Center"
      },
      {
        "command": "deukagentflow.agentflow.openEditor",
        "title": "AgentFlow: Open Editor Command Center"
      },
      {
        "command": "deukagentflow.agentflow.revealPanel",
        "title": "AgentFlow: Reveal Secondary Sidebar"
      },
      {
        "command": "deukagentflow.agentflow.refresh",
        "title": "AgentFlow: Refresh"
      },
      {
        "command": "deukagentflow.agentflow.setActiveTicket",
        "title": "AgentFlow: Set Active Ticket"
      },
      {
        "command": "deukagentflow.agentflow.openTicket",
        "title": "AgentFlow: Open Ticket"
      },
      {
        "command": "deukagentflow.agentflow.runGuard",
        "title": "AgentFlow: Run Guard"
      },
      {
        "command": "deukagentflow.agentflow.copyHandoff",
        "title": "AgentFlow: Copy Handoff Snapshot"
      },
      {
        "command": "deukagentflow.agentflow.switchTarget",
        "title": "AgentFlow: Switch Target"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "tsc -p ./",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "~5.3.0"
  }
}
